{
  "name": "rolls-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "bash scripts/ensure-macos-hermesc.sh && bash scripts/patch-gesture-handler-cmake.sh",
    "android:emulator": "bash scripts/start-android-emulator.sh",
    "android:emulator:software-gpu": "ROLLS_EMULATOR_GPU=swiftshader_indirect bash scripts/start-android-emulator.sh",
    "android:pixel8": "bash scripts/run-android-on-avd.sh Pixel_8",
    "android:medium-phone": "bash scripts/run-android-on-avd.sh Medium_Phone_API_36.1",
    "android": "npm run android:autolinking && react-native run-android",
    "android:fast": "react-native run-android --active-arch-only",
    "android:autolinking": "bash scripts/android-regenerate-autolinking.sh",
    "android:install": "npm run android:autolinking && cd android && ./gradlew installDebug",
    "android:assemble-release": "npm run android:autolinking && cd android && ./gradlew assembleRelease",
    "android:metro-connect": "bash scripts/android-metro-connect.sh",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:fix-mipmap": "bash scripts/fix-android-mipmap-dupes.sh",
    "android:nuke-cxx": "bash scripts/android-nuke-cxx.sh",
    "android:nuke-lib-builds": "bash scripts/android-nuke-node-modules-android-build.sh",
    "fix:android-dupes": "bash scripts/android-remove-finder-dupes-in-build.sh",
    "fix:mipmap": "bash scripts/fix-android-mipmap-dupes.sh",
    "start:lan": "react-native start --host 0.0.0.0",
    "start:reset": "react-native start --host 0.0.0.0 --reset-cache",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --host 0.0.0.0",
    "test": "jest",
    "generate:launcher": "node scripts/generate-launcher-icons-default.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/in-app-messaging": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.39.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-image-resizer": "^1.4.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-xml-parser": "5.5.8"
  }
}
