# Copy to ".env" in the project root (never commit .env).
# Supabase → Project Settings → API: Project URL and anon / publishable key.
#
# The client key is still "public" in the shipped app; real protection is RLS + policies.
# If this key was ever committed to git or a public repo, rotate it in the Supabase dashboard.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Roll invite links use https://YOUR_PROJECT.supabase.co/functions/v1/roll-invite?t=...
# Deploy the Edge Function once: npx supabase functions deploy roll-invite
